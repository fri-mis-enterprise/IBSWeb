@using System.Text.Json
@using System.Text.RegularExpressions
@using IBS.Models.Enums
@model FilprideMasterFileRequest

@functions {
    private sealed class FieldGroup
    {
        public FieldGroup(string title, params string[] fields)
        {
            Title = title;
            Fields = fields;
        }

        public string Title { get; }

        public string[] Fields { get; }
    }

    private static string DisplayName(string value) =>
        value switch
        {
            "CustomerTin" or "SupplierTin" or "BranchTin" => "TIN",
            "CreditLimitAsOfToday" => "Available Credit Limit",
            "CwVatPercent" => "Withholding VAT Percentage",
            "CwtPercent" => "Withholding Tax Percentage",
            "WithHoldingVat" => "Subject to Withholding VAT",
            "WithHoldingTax" => "Subject to Withholding Tax",
            "CustomerId" => "Customer",
            "SupplierId" => "Supplier",
            "ParentAccountId" => "Parent Account",
            "CurrentAndPreviousId" => "Current and Previous Account",
            "UnearnedId" => "Unearned Account",
            "CommissioneeId" => "Commissionee",
            "ProofOfRegistrationFileName" => "Proof of BIR Registration",
            "ProofOfExemptionFileName" => "Proof of Exemption",
            "RequiresPriceAdjustment" => "Requires Price Adjustment",
            _ => Regex.Replace(Regex.Replace(value, "([a-z0-9])([A-Z])", "$1 $2"), " Id$", " ID")
        };

    private static string DisplayValue(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.Null or JsonValueKind.Undefined => "Not provided",
        JsonValueKind.True => "Yes",
        JsonValueKind.False => "No",
        JsonValueKind.String => string.IsNullOrWhiteSpace(value.GetString()) ? "Not provided" : value.GetString()!,
        _ => value.ToString()
    };

    private static bool ShouldDisplay(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.Null or JsonValueKind.Undefined => false,
        JsonValueKind.String => !string.IsNullOrWhiteSpace(value.GetString()),
        _ => true
    };

    private static FieldGroup[] FieldGroups(FilprideMasterFileType type) => type switch
    {
        FilprideMasterFileType.Customer =>
        [
            new("Customer Details", "Type", "CustomerName", "CustomerAddress", "ZipCode", "CustomerTin", "BusinessStyle", "CustomerType", "ClusterCode", "StationCode"),
            new("Terms", "CustomerTerms", "VatType", "CreditLimit", "CreditLimitAsOfToday", "RetentionRate", "RequiresPriceAdjustment"),
            new("Withholding Taxes", "WithHoldingVat", "CwVatPercent", "WithHoldingTax", "CwtPercent"),
            new("Commission", "CommissioneeId", "CommissionRate")
        ],
        FilprideMasterFileType.CustomerBranch =>
        [
            new("Branch Details", "CustomerId", "BranchName", "BranchAddress", "BranchTin")
        ],
        FilprideMasterFileType.Supplier =>
        [
            new("Supplier Details", "Category", "TradeName", "SupplierName", "SupplierAddress", "ZipCode", "SupplierTin", "Branch", "EmployeeNumber"),
            new("Terms and Tax", "SupplierTerms", "VatType", "TaxType", "DefaultExpenseNumber", "WithholdingTaxPercent", "WithholdingTaxTitle"),
            new("Tax Exemption", "ReasonOfExemption", "Validity", "ValidityDate"),
            new("Supporting Documents", "ProofOfRegistrationFileName", "ProofOfExemptionFileName"),
            new("Pricing", "RequiresPriceAdjustment")
        ],
        FilprideMasterFileType.BankAccount =>
        [
            new("Bank Account Details", "AccountNo", "AccountName", "Bank", "Branch")
        ],
        FilprideMasterFileType.Service =>
        [
            new("Service Details", "Name", "CurrentAndPreviousId", "UnearnedId", "Percent")
        ],
        FilprideMasterFileType.ChartOfAccount =>
        [
            new("Account Details", "ParentAccountId", "AccountName")
        ],
        FilprideMasterFileType.PickupPoint =>
        [
            new("Pickup Point Details", "Depot", "SupplierId")
        ],
        _ => []
    };

    private static string StatusClass(FilprideMasterFileRequestStatus status) => status switch
    {
        FilprideMasterFileRequestStatus.Approved => "request-status-approved",
        FilprideMasterFileRequestStatus.Rejected => "request-status-rejected",
        FilprideMasterFileRequestStatus.Canceled => "request-status-canceled",
        _ => "request-status-pending"
    };
}

@{
    ViewData["Title"] = $"Master File Request #{Model.Id}";
    bool approver = User.IsInRole("Admin") || User.IsInRole("ManagementAccountingManager");
    using JsonDocument payload = JsonDocument.Parse(Model.PayloadJson);
    var values = new Dictionary<string, JsonElement>(StringComparer.OrdinalIgnoreCase);
    foreach (JsonProperty property in payload.RootElement.EnumerateObject())
    {
        values[property.Name] = property.Value;
    }
    var referenceNames = ViewBag.ReferenceNames as IReadOnlyDictionary<string, string>
        ?? new Dictionary<string, string>();
}

<link rel="stylesheet" href="~/css/index-style.css" />
<link rel="stylesheet" href="~/css/master-file-request.css" />

<div class="master-file-request-page master-file-request-details">
    <div class="card master-file-request-card mt-4">
        <div class="d-flex justify-content-between align-items-center bg-secondary p-3 rounded shadow">
            <div>
                <p class="text-white-50 mb-1">@DisplayName(Model.MasterFileType.ToString())</p>
                <h1 class="h2 text-white m-0">Request #@Model.Id</h1>
            </div>
            <span class="request-status @StatusClass(Model.Status)">@DisplayName(Model.Status.ToString())</span>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Remarks) ||
                 (!string.IsNullOrWhiteSpace(Model.ApprovedBy) && Model.ApprovedDate.HasValue))
            {
                <section class="request-content-card request-detail-section mb-3" aria-label="Decision remarks">
                    <h2 class="request-section-title">@(Model.Status == FilprideMasterFileRequestStatus.Rejected ? "Rejection Remarks" : "Approver Remarks")</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <p class="mb-1">@Model.Remarks</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy) && Model.ApprovedDate.HasValue)
                    {
                        <small class="text-muted">@Model.ApprovedBy · @Model.ApprovedDate.Value.ToString("MMM dd, yyyy h:mm tt")</small>
                    }
                </section>
            }
            <div class="request-detail-groups">
                @foreach (FieldGroup group in FieldGroups(Model.MasterFileType))
                {
                    bool hasValues = false;
                    foreach (string field in group.Fields)
                    {
                        if (values.TryGetValue(field, out JsonElement value) && ShouldDisplay(value))
                        {
                            hasValues = true;
                            break;
                        }
                    }

                    @if (hasValues)
                    {
                        <section class="request-content-card request-detail-section" aria-label="@group.Title">
                            <h2 class="request-section-title">@group.Title</h2>
                            <dl class="request-detail-list">
                                @foreach (string field in group.Fields)
                                {
                                    if (!values.TryGetValue(field, out JsonElement value) || !ShouldDisplay(value))
                                    {
                                        continue;
                                    }

                                    <div class="request-detail-row">
                                        <dt>@DisplayName(field)</dt>
                                        <dd style="white-space: normal">
                                            @if (field is "ProofOfRegistrationFileName" or "ProofOfExemptionFileName")
                                            {
                                                <a asp-action="DownloadSupplierDocument"
                                                   asp-route-id="@Model.Id"
                                                   asp-route-registration="@(field == "ProofOfRegistrationFileName")"
                                                   target="_blank"
                                                   rel="noopener">@DisplayValue(value)</a>
                                            }
                                            else
                                            {
                                                @(referenceNames.TryGetValue(field, out var referenceName)
                                                    ? referenceName
                                                    : DisplayValue(value))
                                            }
                                        </dd>
                                    </div>
                                }
                            </dl>
                        </section>
                    }
                }
            </div>

            @if (approver && Model.Status == FilprideMasterFileRequestStatus.ForApproval)
            {
                <div class="row pt-3">
                    <div class="col-6 col-md-3">
                        <form id="approveForm" asp-action="Approve" asp-route-id="@Model.Id" method="post">
                            <input id="approveRemarks" type="hidden" name="remarks" />
                        </form>
                        <form id="rejectForm" asp-action="Reject" asp-route-id="@Model.Id" method="post">
                            <input id="rejectRemarks" type="hidden" name="remarks" />
                        </form>
                        <button id="requestActionButton" class="btn btn-primary form-control buttons" type="button">Action</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-action="Index" class="btn btn-outline-primary form-control">Back to requests</a>
                    </div>
                </div>
            }

            @if (!approver || Model.Status != FilprideMasterFileRequestStatus.ForApproval)
            {
                <div class="request-actions mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-1"></i> Back to requests
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('requestActionButton')?.addEventListener('click', function () {
            Swal.fire({
                title: 'Select action',
                icon: 'question',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Approve',
                denyButtonText: 'Reject',
                confirmButtonColor: '#198754',
                denyButtonColor: '#dc3545'
            }).then(function (decision) {
                if (!decision.isConfirmed && !decision.isDenied) {
                    return;
                }

                const isApproval = decision.isConfirmed;
                Swal.fire({
                    title: isApproval ? 'Approve request?' : 'Reject request?',
                    input: 'textarea',
                    inputLabel: isApproval ? 'Remarks (optional)' : 'Reason for rejection',
                    inputPlaceholder: isApproval ? 'Add context for the requester' : 'Explain what needs to be corrected',
                    icon: isApproval ? 'question' : 'warning',
                    showCancelButton: true,
                    inputAttributes: { maxlength: 1000 },
                    confirmButtonText: isApproval ? 'Approve' : 'Reject',
                    confirmButtonColor: isApproval ? '#198754' : '#dc3545',
                    inputValidator: function (value) {
                        return !isApproval && !value.trim() ? 'A reason for rejection is required.' : null;
                    }
                }).then(function (result) {
                    if (!result.isConfirmed) {
                        return;
                    }

                    document.getElementById(isApproval ? 'approveRemarks' : 'rejectRemarks').value = result.value || '';
                    document.getElementById(isApproval ? 'approveForm' : 'rejectForm').submit();
                });
            });
        });
    </script>
}
